{
  "name": "theswampverse",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "run_worker_first": ["/api/*"],
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "swampverse",
      "database_id": "705ad90d-818d-4c1d-b583-1d54100fec7a"
    }
  ]
}
