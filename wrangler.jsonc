{
  // Worker name must match the Worker already deployed in Cloudflare
  "name": "swampverse",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    // only /api/* runs the Worker; every other URL is served as a plain static file
    "run_worker_first": ["/api/*"],
    "binding": "ASSETS"
  },
  // Delve multiplayer: one Durable Object per room (class DelveRoom in worker.js, SQLite-backed so it runs on the Workers Free plan)
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "DelveRoom" }]
  },
  "migrations": [{ "tag": "v1-delve-rooms", "new_sqlite_classes": ["DelveRoom"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "swampverse",
      "database_id": "705ad90d-818d-4c1d-b583-1d54100fec7a"
    }
  ]
}
